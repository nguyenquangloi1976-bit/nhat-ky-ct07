<template>
  <div>
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800">
        {{ entry?.is_locked ? 'Xem' : 'Sửa' }} nhật ký thi công
      </h1>
      <NuxtLink to="/diary" class="text-sm text-primary-600 hover:underline">← Danh sách</NuxtLink>
    </div>

    <div v-if="loading" class="text-center text-gray-400 py-12">Đang tải...</div>

    <template v-else-if="entry">
      <!-- Entry info -->
      <div class="bg-white rounded-lg shadow-sm border p-6 mb-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
          <div>
            <span class="text-gray-500">Công trình:</span>
            <p class="font-medium">{{ structure?.name }}</p>
          </div>
          <div>
            <span class="text-gray-500">Loại:</span>
            <p class="font-medium">{{ structure?.structure_types?.name }}</p>
          </div>
          <div>
            <span class="text-gray-500">Ngày:</span>
            <p class="font-medium">{{ entry.entry_date }}</p>
          </div>
          <div>
            <span class="text-gray-500">Trạng thái:</span>
            <span :class="[
              'inline-block px-2 py-0.5 text-xs rounded-full mt-1',
              entry.is_locked ? 'bg-gray-100 text-gray-600' : 'bg-green-100 text-green-700'
            ]">
              {{ entry.is_locked ? 'Đã khóa' : 'Nháp' }}
            </span>
          </div>
        </div>
      </div>

      <!-- Work items -->
      <div class="bg-white rounded-lg shadow-sm border mb-4 overflow-hidden">
        <h2 class="font-semibold text-gray-700 px-6 pt-6 pb-3">Khối lượng</h2>

        <!-- Table with grouped rows -->
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-600 text-xs uppercase tracking-wide">
              <tr>
                <th class="text-left px-3 py-2 min-w-[200px]">Hạng mục</th>
                <th class="text-center px-3 py-2 w-16">ĐV</th>
                <th class="text-center px-3 py-2 w-20">KL TK</th>
                <th v-if="showLeftRight" class="text-center px-3 py-2 w-16">Bên</th>
                <th class="text-center px-3 py-2 w-16">Đợt</th>
                <th class="text-center px-3 py-2 w-28">KL thực hiện</th>
                <th class="text-left px-3 py-2">Ghi chú</th>
                <th v-if="!entry.is_locked" class="px-2 py-2 w-8"></th>
              </tr>
            </thead>
            <tbody>
              <template v-for="(group, gIdx) in groupedLines" :key="gIdx">
                <!-- Group header -->
                <tr v-if="group.name" class="bg-indigo-50 cursor-pointer hover:bg-indigo-100 transition-colors"
                  @click="toggleGroup(group.name)">
                  <td :colspan="colSpan" class="px-3 py-2">
                    <div class="flex items-center gap-2">
                      <span class="text-xs transition-transform" :class="{ 'rotate-90': !collapsedGroups[group.name] }">▶</span>
                      <span class="font-medium text-sm">{{ group.name }}</span>
                      <span class="text-xs text-gray-400">({{ group.lines.length }})</span>
                    </div>
                  </td>
                </tr>
                <!-- Group rows -->
                <template v-if="!group.name || !collapsedGroups[group.name]">
                  <tr v-for="line in group.lines" :key="line._idx"
                    class="border-t border-gray-100 hover:bg-gray-50">
                    <td class="px-3 py-1.5">
                      <template v-if="entry.is_locked">
                        <span class="font-medium">{{ line.work_item_name }}</span>
                      </template>
                      <SearchSelect v-else
                        :modelValue="line.work_item_id"
                        @update:modelValue="(val: string) => onWorkItemSelect(line._idx, val)"
                        :options="workItemOptions"
                        placeholder="Chọn hạng mục..."
                        showAdd
                        @add-new="openAddWorkItem"
                      />
                    </td>
                    <td class="px-2 py-1.5 text-center text-gray-500 text-xs">{{ line.unit }}</td>
                    <td class="px-2 py-1.5 text-center text-gray-400 text-xs">{{ line.design_quantity ?? '—' }}</td>
                    <td v-if="showLeftRight" class="px-2 py-1.5 text-center">
                      <template v-if="entry.is_locked">{{ line.side || '—' }}</template>
                      <select v-else v-model="line.side" class="input-xs w-14">
                        <option :value="null">—</option>
                        <option value="T">T</option>
                        <option value="P">P</option>
                      </select>
                    </td>
                    <td class="px-2 py-1.5 text-center">
                      <template v-if="entry.is_locked">{{ line.batch_number }}</template>
                      <input v-else v-model.number="line.batch_number" type="number" min="1"
                        class="input-xs w-14 text-center" />
                    </td>
                    <td class="px-2 py-1.5 text-center">
                      <template v-if="entry.is_locked">
                        <span class="font-semibold">{{ line.quantity }}</span>
                      </template>
                      <input v-else v-model.number="line.quantity" type="number" min="0" step="0.01"
                        class="input-xs w-24 text-right" />
                    </td>
                    <td class="px-2 py-1.5">
                      <template v-if="entry.is_locked">{{ line.notes || '' }}</template>
                      <input v-else v-model="line.notes" class="input-xs w-full" placeholder="..." />
                    </td>
                    <td v-if="!entry.is_locked" class="px-2 py-1.5 text-center">
                      <button @click="removeLine(line._idx)"
                        class="text-red-400 hover:text-red-600 text-xs">✕</button>
                    </td>
                  </tr>
                </template>
              </template>
            </tbody>
          </table>
        </div>

      </div>

      <!-- Weather / Notes -->
      <div class="bg-white rounded-lg shadow-sm border p-6 mb-4">
        <h2 class="font-semibold text-gray-700 mb-4">Thông tin bổ sung</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-gray-600 mb-1">Thời tiết</label>
            <template v-if="entry.is_locked">
              <p class="text-sm">{{ entryMeta.weather || '—' }}</p>
            </template>
            <select v-else v-model="entryMeta.weather" class="input-field w-full">
              <option value="">-- Chọn --</option>
              <option>Nắng</option>
              <option>Mưa</option>
              <option>Nhiều mây</option>
              <option>Nắng gián đoạn mưa</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Ghi chú chung</label>
            <template v-if="entry.is_locked">
              <p class="text-sm">{{ entryMeta.notes || '—' }}</p>
            </template>
            <textarea v-else v-model="entryMeta.notes" class="input-field w-full h-20"
              placeholder="Ghi chú..."></textarea>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex space-x-3">
        <template v-if="!entry.is_locked">
          <button @click="saveAll" :disabled="saving"
            class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 disabled:opacity-50 text-sm font-medium">
            {{ saving ? 'Đang lưu...' : 'Lưu nháp' }}
          </button>
          <button @click="saveAndLock" :disabled="saving"
            class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:opacity-50 text-sm font-medium">
            Lưu & Khóa
          </button>
        </template>
        <button v-if="entry.is_locked && isAdmin" @click="handleUnlock"
          class="px-6 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 text-sm font-medium">
          Mở khóa
        </button>
        <button v-if="isAdmin" @click="confirmDeleteEntry"
          class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm font-medium">
          Xoá nhật ký
        </button>
        <NuxtLink to="/diary" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">
          Quay lại
        </NuxtLink>
      </div>
    </template>

    <!-- Modal thêm hạng mục mới -->
    <div v-if="showAddModal" class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center"
      @click.self="showAddModal = false">
      <div class="bg-white rounded-lg shadow-xl p-6 w-full max-w-md">
        <h3 class="font-semibold text-gray-800 mb-4">Thêm hạng mục mới</h3>
        <div class="space-y-3">
          <div>
            <label class="block text-sm text-gray-600 mb-1">Nhóm</label>
            <input v-model="newWI.group_name" class="input-field w-full" placeholder="VD: Kết cấu phần dưới" />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Tên hạng mục <span class="text-red-500">*</span></label>
            <input v-model="newWI.name" class="input-field w-full" placeholder="VD: Móng cọc khoan nhồi" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm text-gray-600 mb-1">Đơn vị</label>
              <input v-model="newWI.unit" class="input-field w-full" placeholder="VD: cọc, m3" />
            </div>
            <div>
              <label class="block text-sm text-gray-600 mb-1">KL thiết kế</label>
              <input v-model.number="newWI.design_quantity" type="number" step="0.01"
                class="input-field w-full" placeholder="0" />
            </div>
          </div>
        </div>
        <div class="flex justify-end gap-2 mt-5">
          <button @click="showAddModal = false"
            class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">
            Hủy
          </button>
          <button @click="saveNewWorkItem" :disabled="!newWI.name"
            class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 disabled:opacity-40 text-sm font-medium">
            Lưu
          </button>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup lang="ts">
definePageMeta({ middleware: 'auth' })

const route = useRoute()
const router = useRouter()
const { getWorkItems, addWorkItem: createWorkItem } = useStructures()
const { getEntry, saveLine, deleteLine, updateEntry, lockEntry, unlockEntry, deleteEntry } = useDiary()
const { currentProject } = useProject()
const { isAdmin } = useAuth()
const { success, error: showError } = useToast()

const loading = ref(true)
const saving = ref(false)
const entry = ref<any>(null)
const structure = ref<any>(null)
const formLines = ref<any[]>([])
const entryMeta = reactive({ weather: '', notes: '' })

// Dropdown hạng mục
const allWorkItems = ref<any[]>([])

// Group collapse state
const collapsedGroups = ref<Record<string, boolean>>({})

// Modal thêm hạng mục mới
const showAddModal = ref(false)
const newWI = reactive({ name: '', group_name: '', unit: '', design_quantity: null as number | null })

function openAddWorkItem() {
  Object.assign(newWI, { name: '', group_name: '', unit: '', design_quantity: null })
  showAddModal.value = true
}

async function saveNewWorkItem() {
  if (!newWI.name || !entry.value) return
  try {
    const created = await createWorkItem({
      structure_id: entry.value.structure_id,
      name: newWI.name,
      group_name: newWI.group_name || null,
      unit: newWI.unit || null,
      design_quantity: newWI.design_quantity || null,
    })
    allWorkItems.value.push(created)
    showAddModal.value = false
    success('Đã thêm hạng mục: ' + created.name)
  } catch (e: any) {
    showError(e.message)
  }
}

// T/P hiển thị khi dự án là "Mở rộng"
const showLeftRight = computed(() => {
  return currentProject.value?.has_left_right ?? false
})

// Column span for group header
const colSpan = computed(() => {
  let cols = 7
  if (showLeftRight.value) cols++
  if (!entry.value?.is_locked) cols++
  return cols
})

const workItemOptions = computed(() =>
  allWorkItems.value.map(wi => ({
    value: wi.id,
    label: wi.group_name ? `${wi.group_name} — ${wi.name}` : wi.name,
  }))
)

// Grouped lines for display
const groupedLines = computed(() => {
  const groups: { name: string; lines: any[] }[] = []
  const groupMap = new Map<string, any[]>()
  const ungrouped: any[] = []

  for (const line of formLines.value) {
    const gn = line.group_name || ''
    if (gn) {
      if (!groupMap.has(gn)) {
        groupMap.set(gn, [])
        groups.push({ name: gn, lines: groupMap.get(gn)! })
      }
      groupMap.get(gn)!.push(line)
    } else {
      ungrouped.push(line)
    }
  }

  if (ungrouped.length) {
    groups.push({ name: '', lines: ungrouped })
  }

  return groups
})

function toggleGroup(name: string) {
  collapsedGroups.value[name] = !collapsedGroups.value[name]
}

function ensureEmptyRow() {
  const hasEmpty = formLines.value.some(l => !l.work_item_id)
  if (!hasEmpty) {
    const idx = formLines.value.length
    formLines.value.push({
      _idx: idx,
      id: null,
      work_item_id: '',
      work_item_name: '',
      unit: '',
      design_quantity: null,
      group_name: '',
      side: null,
      batch_number: 1,
      quantity: 0,
      notes: '',
    })
  }
}

function reindexLines() {
  formLines.value.forEach((l, i) => { l._idx = i })
}

function onWorkItemSelect(idx: number, workItemId: string) {
  const line = formLines.value[idx]
  line.work_item_id = workItemId
  const wi = allWorkItems.value.find(w => w.id === workItemId)
  if (wi) {
    line.work_item_name = wi.name
    line.unit = wi.unit
    line.design_quantity = wi.design_quantity
    line.group_name = wi.group_name || ''
  }
  ensureEmptyRow()
  reindexLines()
}

async function loadEntry() {
  loading.value = true
  try {
    const { $supabase } = useNuxtApp()
    const entryId = route.params.id as string

    // Load entry with structure info
    const { data, error: err } = await $supabase
      .from('diary_entries')
      .select('*, structures(*, structure_types(name))')
      .eq('id', entryId)
      .single()

    if (err) throw err
    entry.value = data
    structure.value = data.structures
    entryMeta.weather = data.weather || ''
    entryMeta.notes = data.notes || ''

    // Load work items cho dropdown
    allWorkItems.value = await getWorkItems(data.structure_id)

    // Load existing lines
    const { data: existingLines } = await $supabase
      .from('diary_lines')
      .select('*, work_items(name, unit, design_quantity, group_name)')
      .eq('entry_id', entryId)
      .order('created_at')

    formLines.value = (existingLines || []).map((line: any, i: number) => ({
      _idx: i,
      id: line.id,
      work_item_id: line.work_item_id,
      work_item_name: line.work_items?.name || '?',
      unit: line.work_items?.unit || '?',
      design_quantity: line.work_items?.design_quantity,
      group_name: line.work_items?.group_name || '',
      side: line.side,
      batch_number: line.batch_number,
      quantity: line.quantity,
      notes: line.notes || '',
    }))
    if (!entry.value.is_locked) ensureEmptyRow()
  } catch (e: any) {
    showError(e.message)
  } finally {
    loading.value = false
  }
}

async function removeLine(idx: number) {
  const line = formLines.value[idx]
  if (line.id) {
    await deleteLine(line.id)
  }
  formLines.value.splice(idx, 1)
  reindexLines()
}

async function saveAll() {
  saving.value = true
  try {
    await updateEntry(entry.value.id, {
      weather: entryMeta.weather || null,
      notes: entryMeta.notes || null,
    })

    for (const line of formLines.value) {
      if (!line.work_item_id) continue
      if (line.quantity > 0 || line.id) {
        const saved = await saveLine({
          id: line.id || undefined,
          entry_id: entry.value.id,
          work_item_id: line.work_item_id,
          side: line.side || null,
          batch_number: line.batch_number || 1,
          quantity: line.quantity || 0,
          notes: line.notes || null,
        })
        line.id = saved.id
      }
    }
    success('Đã lưu nhật ký')
  } catch (e: any) {
    showError(e.message)
  } finally {
    saving.value = false
  }
}

async function saveAndLock() {
  await saveAll()
  if (!saving.value) {
    try {
      await lockEntry(entry.value.id)
      entry.value.is_locked = true
      success('Đã khóa nhật ký')
    } catch (e: any) {
      showError(e.message)
    }
  }
}

async function confirmDeleteEntry() {
  const structName = structure.value?.name || ''
  const date = entry.value?.entry_date || ''
  if (!confirm(`Xoá nhật ký ngày ${date} — ${structName}?\nTất cả dòng khối lượng sẽ bị xoá vĩnh viễn!`)) return
  try {
    await deleteEntry(entry.value.id)
    success('Đã xoá nhật ký')
    router.push('/diary')
  } catch (e: any) {
    showError(e.message)
  }
}

async function handleUnlock() {
  try {
    await unlockEntry(entry.value.id)
    entry.value.is_locked = false
    success('Đã mở khóa nhật ký')
  } catch (e: any) {
    showError(e.message)
  }
}

onMounted(() => loadEntry())
</script>

<style scoped>
.input-field {
  @apply px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500;
}
.input-xs {
  @apply px-2 py-1 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-primary-500 focus:border-primary-500;
}
</style>
